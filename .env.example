# Copiar a `.env` y ajustar. Docker Compose lo lee automáticamente.
#
# Todo funciona sin `.env` salvo Airflow, que necesita HOST_PROJECT_PATH.

# --- MinIO ----------------------------------------------------------------
# Credenciales del almacenamiento (también las del panel en http://localhost:9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Pipeline -------------------------------------------------------------
# Dónde viven las capas Medallion: "s3" (MinIO) o "local" (carpeta data/)
OLIST_STORAGE=s3

# --- Airflow --------------------------------------------------------------
# HOST_PROJECT_PATH es OPCIONAL. El DAG deduce solo la ruta del proyecto en el host,
# inspeccionando cómo Compose montó /opt/airflow/dags.
#
# Solo hace falta definirla si esa deducción falla. Es la ruta TAL COMO LA VE EL
# DEMONIO DE DOCKER, no como la ve tu shell: Airflow lanza cada tarea en un contenedor
# nuevo y el montaje lo resuelve el demonio contra su propio sistema de archivos.
#
#   Windows (Docker Desktop):  /run/desktop/mnt/host/<letra minúscula>/<ruta>
#                              ej. /run/desktop/mnt/host/d/EcommerceDataPipeline_PI
#   macOS (Docker Desktop):    la ruta normal, ej. /Users/vos/olist-data-pipeline
#   Linux:                     la ruta normal, ej. /home/vos/olist-data-pipeline
#
# Para comprobar que una ruta es correcta:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock docker:cli \
#     sh -c "docker run --rm -v <TU_RUTA>:/x alpine ls /x"
# HOST_PROJECT_PATH=

# Red de Compose donde vive MinIO, para que los contenedores que lanza Airflow lo
# puedan resolver por nombre. Es "<nombre del proyecto>_default".
DOCKER_NETWORK=ecommercedatapipeline_pi_default

# Credenciales del panel de Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
